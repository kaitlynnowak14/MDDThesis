##### Load Hail MatrixTable and Filter to European Ancestry Cohort #####
# Import libraries
from datetime import datetime
import os
import hail as hl

# Start timer
start = datetime.now()

# Set environment variables
bucket = os.getenv('WORKSPACE_BUCKET')  # Example: 'gs://fc-your-bucket-name'
genomic_location = os.getenv("CDR_STORAGE_PATH")  # Not used here directly

# Initialize Hail with GRCh38 reference
hl.init(default_reference='GRCh38')  # FIXED initialization

##### Load Array Hail MatrixTable #####
# Define MatrixTable path (can keep hardcoded)
mt_array_path = "gs://fc-aou-datasets-controlled/v8/microarray/hail.mt"
mt_array = hl.read_matrix_table(mt_array_path)

# Optional: Inspect MatrixTable
mt_array.describe()
print("MatrixTable dimensions (rows, cols):", mt_array.count())

##### Filter to European Ancestry Cohort #####
# Load your cohort CSV with person_id (replace with your real bucket path)
cohort_csv_path = 'gs://your-bucket/path/to/cohort_ids.csv'  # FIX: Your actual bucket
cohort_ids = hl.import_table(cohort_csv_path, key='person_id')

# Filter MatrixTable to only samples in cohort
# mt_array.s = sample ID, assumed to match person_id
mt_array_filtered = mt_array.filter_cols(hl.literal(cohort_ids['person_id']).contains(mt_array.s))

# Optional: Confirm filter result
print("Filtered MatrixTable dimensions:", mt_array_filtered.count())

##### Save Filtered MatrixTable for Reuse #####
filtered_mt_path = f'{bucket}/filtered_mt/filtered_cohort.mt'
mt_array_filtered.write(filtered_mt_path, overwrite=True)

##### Export Filtered MatrixTable to PLINK Format #####
# Define PLINK output prefix in your workspace bucket
plink_output_prefix = f'{bucket}/prs_plink/filtered_cohort'

# Export filtered data to PLINK (for PRS)
hl.export_plink(mt_array_filtered, output=plink_output_prefix)  # FIX: export filtered data

# Print elapsed time
print("Done in:", datetime.now() - start)
