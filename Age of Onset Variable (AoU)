##### Age of Onset Variable #####
#################################

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy.stats import skew, kurtosis
import os

# Ensure bucket exists
bucket = os.getenv("WORKSPACE_BUCKET")
if bucket is None:
    raise ValueError("WORKSPACE_BUCKET environment variable not found.")

##### Create Age of Onset Variable #####
merged_df['date_of_birth'] = pd.to_datetime(merged_df['date_of_birth'])
merged_df['condition_start_datetime'] = pd.to_datetime(merged_df['condition_start_datetime'])

merged_df['age_of_onset'] = np.floor(
    (merged_df['condition_start_datetime'] - merged_df['date_of_birth']).dt.days / 365.25
).astype('Int64')

# Drop rows missing age of onset
merged_df = merged_df.dropna(subset=['age_of_onset'])

# Save dataset with age_of_onset
csv_path = f"{bucket}/exports/merged_with_age_of_onset.csv"
merged_df.to_csv(csv_path, index=False)
print(f"Saved merged dataset with age_of_onset to: {csv_path}")

##### Plot histogram #####
plt.figure(figsize=(10,6))
plt.hist(merged_df['age_of_onset'], bins=30, color='skyblue', edgecolor='black')
plt.xlabel('Age of Onset (years)')
plt.ylabel('Number of Individuals')
plt.title('Distribution of Age of Onset for MDD')
age_hist_path = f"{bucket}/plots/age_of_onset_hist.png"
plt.savefig(age_hist_path)
plt.close()
print(f"Saved histogram to: {age_hist_path}")

##### Basic stats #####
summary_stats_df = pd.DataFrame({
    'Mean': [merged_df['age_of_onset'].mean()],
    'Median': [merged_df['age_of_onset'].median()],
    'Std': [merged_df['age_of_onset'].std()],
    'Min': [merged_df['age_of_onset'].min()],
    'Max': [merged_df['age_of_onset'].max()],
    'Skew': [skew(merged_df['age_of_onset'])],
    'Kurtosis': [kurtosis(merged_df['age_of_onset'])]
})
summary_stats_path = f"{bucket}/exports/age_of_onset_summary.csv"
summary_stats_df.to_csv(summary_stats_path, index=False)
print(f"Saved summary stats to: {summary_stats_path}")

##### Log-transform (optional) #####
merged_df['age_of_onset_log'] = np.log(merged_df['age_of_onset'] + 1)
plt.figure(figsize=(10,6))
merged_df['age_of_onset_log'].plot(kind='hist', bins=30, color='lightgreen', edgecolor='black', density=True)
merged_df['age_of_onset_log'].plot(kind='kde', color='red')
plt.xlabel('Log-transformed Age of Onset')
plt.ylabel('Density')
plt.title('Distribution of Log-transformed Age of Onset for MDD')
log_hist_path = f"{bucket}/plots/age_of_onset_log_hist.png"
plt.savefig(log_hist_path)
plt.close()
print(f"Saved log-transformed histogram to: {log_hist_path}")
