##### Function to valculate counts and percentages
# Make table
def make_table(df, categories):
    results = []
    total = len(df)
    
    for var, cats in categories.items():
        # Add a header row
        results.append({"Characteristic": var, "n": "", "%": ""})
        for cat in cats:
            n = (df[var] == cat).sum()
            pct = round((n / total) * 100, 1) if total > 0 else 0
            results.append({"Characteristic": f"   {cat}", "n": n, "%": pct})
    return pd.DataFrame(results)

