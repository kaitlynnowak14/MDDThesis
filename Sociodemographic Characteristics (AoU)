##### Helper function to reload later #####
def load_table1(bucket_name=bucket, blob_name="results/table1_characteristics.csv"):
    client = storage.Client()
    bucket_obj = client.bucket(bucket_name)
    blob = bucket_obj.blob(blob_name)
    local_reload_path = "/tmp/table1_characteristics_reload.csv"
    blob.download_to_filename(local_reload_path)
    print(f"Reloaded Table 1 from bucket to {local_reload_path}")
    return pd.read_csv(local_reload_path)

