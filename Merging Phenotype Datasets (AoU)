## In Hail ##

import hail as hl
import pandas as pd
import os

hail.init()

##### Load DataFrames from Provided All of Us Queries #####
person_df = dataset_29072358_person_df
survey_df = dataset_29072358_survey_df
condition_df = dataset_29072358_condition_df

##### Step 1: Summarize Condition Data - First MDD Diagnosis per Person #####
# Convert condition date column to datetime
condition_df['condition_start_datetime'] = pd.to_datetime(condition_df['condition_start_datetime'])

# Get first MDD diagnosis per person
condition_summary = (
    condition_df.sort_values(by='condition_start_datetime')
    .groupby('person_id', as_index=False)
    .first()
)

# Select and rename columns
condition_summary = condition_summary[['person_id', 'condition_start_datetime', 'standard_concept_name']]
condition_summary.rename(columns={
    'condition_start_datetime': 'first_MDD_diagnosis_date',
    'standard_concept_name': 'MDD_concept_name'
}, inplace=True)

##### Step 2: Pivot Survey Data - Each Question as a Column #####
survey_pivot = survey_df.pivot_table(
    index='person_id',
    columns='question_concept_id',
    values='answer_concept_id',
    aggfunc='first'  # Or 'list' if multiple answers should be kept
).reset_index()

##### Step 3: Decode Survey Question Concept IDs to Names #####
# Get unique survey question concept IDs
question_ids = survey_df['question_concept_id'].unique().tolist()

# Create SQL query to get concept names
question_concept_sql = f"""
SELECT concept_id, concept_name
FROM `{os.environ['WORKSPACE_CDR']}.concept`
WHERE concept_id IN ({','.join(map(str, question_ids))})
"""

# Run query and get concept names
question_concept_df = pd.read_gbq(question_concept_sql, dialect='standard')

# Create mapping: concept_id → concept_name
id_to_name = dict(zip(question_concept_df['concept_id'], question_concept_df['concept_name']))

# Rename survey_pivot columns (skip 'person_id')
survey_pivot.rename(columns=id_to_name, inplace=True)

##### Step 4: Merge All DataFrames on person_id #####
# Merge person data + condition summary
merged_df = person_df.merge(condition_summary, on='person_id', how='left')

# Merge with renamed survey data
merged_df = merged_df.merge(survey_pivot, on='person_id', how='left')

##### Step 5: Preview and Save #####
print(merged_df.head())  # Preview first few rows

# Save final merged dataset
merged_df.to_csv('all_of_us_merged_dataset.csv', index=False)
