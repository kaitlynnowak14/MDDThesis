import hail as hl
import pandas as pd
import os
from google.cloud import storage

hail.init()

##### Load DataFrames from Provided All of Us Queries #####
person_df = dataset_27910912_person_df
survey_df = dataset_27910912_survey_df
condition_df = dataset_27910912_condition_df

##### Step 1: Keep only the first condition occurrence per person (earliest date) #####
conditions_unique = condition_df.sort_values("condition_start_datetime").drop_duplicates("person_id")

##### Step 2: Pivot Survey Data (each question becomes a column) #####
# Remove redundant question prefix if needed
survey_df['question'] = survey_df['question'].str.replace(r'^.*?:\s*', '', regex=True)

# Pivot: one row per person, one column per survey question
survey_pivot = survey_df.pivot_table(
    index='person_id',
    columns='question',
    values='answer',
    aggfunc=lambda x: "; ".join(x.astype(str).unique())  # keep unique responses if multiple
).reset_index()

# Flatten column names
survey_pivot.columns.name = None

##### Step 3: Merge All DataFrames on person_id #####
merged_df = person_df.merge(conditions_unique, on='person_id', how='left')
merged_df = merged_df.merge(survey_pivot, on='person_id', how='left')

##### Step 4: Preview and Save #####
print(merged_df.head())

# Save locally
merged_df.to_csv('all_of_us_merged_dataset.csv', index=False)

# Save to bucket
bucket = "fc-secure-6218f59e-a8a7-40a3-96cb-ee93a398ba0b"
