##### Helper function to reload dataset later #####
def load_merged_df(bucket_name=bucket, blob_name="exports/all_of_us_merged_dataset.csv"):
    client = storage.Client()
    bucket_obj = client.bucket(bucket_name)
    blob = bucket_obj.blob(blob_name)
    local_reload_path = "/tmp/all_of_us_merged_dataset_reload.csv"
    blob.download_to_filename(local_reload_path)
    print(f"Reloaded dataset from bucket to {local_reload_path}")
    return pd.read_csv(local_reload_path)

# Next time to load
merged_df = load_merged_df()
print(merged_df.head())
