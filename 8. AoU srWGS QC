##### 1. Load cohort filtered Hail MT #####
import hail as hl
import os
genomic_location = os.getenv("CDR_STORAGE_PATH")

# Helper function to check drops after each QC step
def report_counts(mt, label):
    _, n = mt.count()
    print(f"{label}: {n}")

cohort_mt_path = (
    "gs://fc-secure-6218f59e-a8a7-40a3-96cb-ee93a398ba0b/data/"
    "SNP_data.mt"
)

SNP_data_mt = hl.read_matrix_table(cohort_mt_path)

# confirm loaded correctly 
SNP_data_mt.describe()
report_counts(SNP_data_mt, "Initial cohort MT")

# check sample & variant counts
n_variants, n_samples = SNP_data_mt.count()
print("Variants:", n_variants)
print("Samples:", n_samples)

##### 2. Remove joint callset QC-flagged samples #####
flagged_samples_path = (
    f"{genomic_location}/wgs/short_read/snp_indel/aux/qc/flagged_samples.tsv"
)

flagged_ht = hl.import_table(
    flagged_samples_path,
    key="s",
    types={"s": hl.tstr}
)

# Remove flagged samples
SNP_data_mt = SNP_data_mt.anti_join_cols(flagged_ht)

report_counts(SNP_data_mt, "After removing QC-flagged samples")

##### 3. Remove related individuals #####
related_samples_path = (
    f"{genomic_location}/wgs/short_read/snp_indel/aux/relatedness/relatedness_flagged_samples.tsv"
)

related_ht = (
    hl.import_table(
        related_samples_path,
        types={"sample_id": hl.tstr},
        key="sample_id"
    )
    .rename({"sample_id": "s"})
)

# Remove related samples
SNP_data_mt = SNP_data_mt.anti_join_cols(related_ht)

report_counts(SNP_data_mt, "After removing related individuals")

##### 4. Annotate ancestry + PCs #####
ancestry_pred_path = (
    f"{genomic_location}/wgs/short_read/snp_indel/aux/ancestry/ancestry_preds.tsv"
)

ancestry_ht = (
    hl.import_table(
        ancestry_pred_path,
        key="research_id",
        impute=True,
        types={
            "research_id": hl.tstr,
            "pca_features": hl.tarray(hl.tfloat)
        }
    )
    .rename({"research_id": "s"})
)

# Annotate columns
SNP_data_mt = SNP_data_mt.annotate_cols(
    ancestry = ancestry_ht[SNP_data_mt.s]
)

report_counts(SNP_data_mt, "After ancestry annotation (no filtering yet)")

##### 5. Restrict to EUR-only (drops any that are missing) #####
SNP_data_mt = SNP_data_mt.filter_cols(
    hl.is_defined(SNP_data_mt.ancestry) &
    (SNP_data_mt.ancestry.ancestry_pred == "EUR")
)

report_counts(SNP_data_mt, "After EUR-only restriction")

##### 6. Save final MT #####
final_mt_path = (
    "gs://fc-secure-6218f59e-a8a7-40a3-96cb-ee93a398ba0b/data/"
    "SNP_data_qc_final.mt"
)

SNP_data_mt.write(final_mt_path, overwrite=True)
