import os
import hail as hl

##### Set Environment #####
bucket = os.getenv('WORKSPACE_BUCKET')
genomic_location = os.getenv("CDR_STORAGE_PATH")  # Genomic data bucket

if bucket is None or genomic_location is None:
    raise ValueError("WORKSPACE_BUCKET or CDR_STORAGE_PATH not found. Must run inside a Terra/All of Us notebook.")

##### Initialize Hail #####
hl.init(default_reference='GRCh38')

##### Export Cohort Person IDs #####
