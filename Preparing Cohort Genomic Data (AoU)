!gsutil cp {cohort_csv} {bucket}/{cohort_csv}
print(f"Saved cohort IDs to {bucket}/{cohort_csv}")

##### Load Array Hail MatrixTable #####
mt_array_path = f"{genomic_location}/microarray/hail.mt"
mt_array = hl.read_matrix_table(mt_array_path)
print("Original MatrixTable:")
mt_array.describe()

##### Filter to Cohort #####
# Import cohort IDs as Hail table
cohort_table = hl.import_table(f"{bucket}/{cohort_csv}", key='person_id')

# Filter MatrixTable columns
mt_array_filtered = mt_array.filter_cols(hl.is_defined(cohort_table[mt_array.s]))

# Confirm filtering
n_rows_filtered, n_cols_filtered = mt_array_filtered.count()
print(f"Filtered MatrixTable dimensions: rows={n_rows_filtered}, cols={n_cols_filtered}")

##### Rename Alleles for PLINK Compatibility #####
mt_array_filtered = mt_array_filtered.annotate_rows(
    A1 = mt_array_filtered.alleles[0],  # Effect allele (EA)
    A2 = mt_array_filtered.alleles[1]   # Non-effect allele (NEA)
)
print("Alleles renamed for PLINK export.")

##### Save Filtered MatrixTable #####
filtered_mt_path = f"{bucket}/filtered_mt/filtered_cohort.mt"
mt_array_filtered.write(filtered_mt_path, overwrite=True)
print(f"Filtered MatrixTable saved to {filtered_mt_path}")

##### Export Filtered MatrixTable to PLINK #####
plink_prefix = f"{bucket}/prs_plink/filtered_cohort"
hl.export_plink(mt_array_filtered, output=plink_prefix)
print(f"PLINK files exported with prefix: {plink_prefix}")
