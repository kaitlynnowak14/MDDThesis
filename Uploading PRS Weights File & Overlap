import hail as hl
import pandas as pd
import os

# Your bucket
bucket = os.getenv('WORKSPACE_BUCKET')

# 1. Load AoU microarray MatrixTable (v8)
mt_array_path = "gs://fc-aou-datasets-controlled/v8/microarray/hail.mt"
mt_array = hl.read_matrix_table(mt_array_path)

# 2. Load your SNP weights file (uploaded into your bucket first)
weights_path = f"{bucket}/top10k_prs_weights_hg38.txt"
prs_ht = hl.import_table(weights_path, impute=True, key="SNP")

# 3. Check overlap
# AoU microarray has variants keyed by locus/alleles, not rsID — so we need SNP IDs
# The variant rsIDs are in the `mt_array.row_key` under `rsid`
mt_rsid = mt_array.rows().select("rsid")

# Left join weights onto array rsids
overlap = prs_ht.join(mt_rsid.key_by("rsid"), how="inner")

# Count how many matched
print(f"{overlap.count()} SNPs from your PRS weights found in AoU microarray data")

# Optional: export list of matched SNPs for verification
overlap.export(f"{bucket}/top10k_prs_weights_matched.txt")
