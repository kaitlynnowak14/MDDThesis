##### Load Hail MatrixTable and FIlter to European Ancestry Cohort #####
# Import libraries
from datetime import datetime
import os
import hail as hl

# Start timer
start = datetime.now()

# Set environment variables
bucket = os.getenv('WORKSPACE_BUCKET')
genomic_location = os.getenv("CDR_STORAGE_PATH")

# Initialize Hail with GRCh38
hl.default_reference(new_default_reference = "GRCh38")

##### Load Array Hail MatrixTable #####
mt_array_path = os.getenv("MICROARRAY_HAIL_STORAGE_PATH")
mt_array_path = "gs://fc-aou-datasets-controlled/v8/microarray/hail.mt"
mt_array = hl.read_matrix_table(mt_array_path)

# Inspect data
mt_array.count()
mt_array.describe()

##### Filter to European Ancestry Cohort #####
# Replace bath below with actual cohort CSV when ready
cohort_ids = hl.import_table('gs://your_bucket/path/to/cohort_ids.csv', key = 'person_id')

# Filter MatrixTable to only samples in cohort
mt_array = mt_array.filter_cols(hl.literal(cohort_ids['person_id']).contains(mt_array.s))

##### Export Filtered MatrixTabl to PLINK Format #####
# Define output path in workspace bucket
plink_output_prefix = f'{bucket}/prs_plink/filtered_cohort'

# Export to PLINK for PRS calcuation in PLINK
hl.export_plink(mt_array, output = plink_output_prefix)
