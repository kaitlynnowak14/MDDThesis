##### Create a merged table and harmonize calls #####
#!/usr/bin/env python3
import pandas as pd
import numpy as np

# Filenames (edit if needed)
weights_f = "top10k_prs_weights_hg38.txt"
bim_f = "allofus_qc_final.bim"

# Load weights
w = pd.read_csv(weights_f, sep="\t", dtype=str)
# Ensure required columns exist
req = ["CHROM","POS","ID","EA","NEA","BETA"]
for c in req:
    if c not in w.columns:
        raise SystemExit(f"Missing column {c} in weights file. Found columns: {w.columns.tolist()}")

w['BETA'] = pd.to_numeric(w['BETA'], errors='coerce')
w = w[['CHR' if 'CHR' in w.columns else 'CHROM','POS','ID','EA','NEA','BETA']].rename(columns={'CHR':'CHROM'})

# Load bim
# PLINK .bim columns: 1:chr 2:rsid 3:cm 4:pos 5:allele1(A1) 6:allele2(A2)
bim = pd.read_csv(bim_f, sep="\s+", header=None, dtype=str)
bim.columns = ['CHR','ID','CM','POS','A1','A2']

# Uppercase alleles
for col in ['EA','NEA','A1','A2']:
    if col in w.columns:
        w[col] = w[col].str.upper()
bim['A1'] = bim['A1'].str.upper()
bim['A2'] = bim['A2'].str.upper()
w['EA'] = w['EA'].str.upper()
w['NEA'] = w['NEA'].str.upper()

# Merge by ID
m = pd.merge(w, bim, on='ID', suffixes=('_w','_t'), how='inner')

print(f"Merged {len(m)} SNPs present in both weights and target (by ID).")

# complement map
comp_map = {'A':'T','T':'A','C':'G','G':'C'}
def complement(allele):
    if pd.isna(allele): return allele
    return ''.join(comp_map.get(b,b) for b in allele)

def classify(row):
    ea = row['EA']
    nea = row['NEA']
    a1 = row['A1']
    a2 = row['A2']
    # exact match
    if ea == a1 and nea == a2:
        return 'match', False
    if ea == a2 and nea == a1:
        return 'swap', True
    # complement (strand flip)
    cea = complement(ea)
    cnea = complement(nea)
    if cea == a1 and cnea == a2:
        return 'strand_match', False
    if cea == a2 and cnea == a1:
        return 'strand_swap', True
    # ambiguous palindromic
    allele_set = {ea, nea}
    if allele_set == {'A','T'} or allele_set == {'T','A'} or allele_set == {'G','C'} or allele_set == {'C','G'}:
        return 'ambiguous', None
    return 'mismatch', None

res = m.apply(lambda r: pd.Series(classify(r), index=['class','flip']), axis=1)
m = pd.concat([m, res], axis=1)

# Flip BETA if needed
def flip_beta(beta, flip):
    if pd.isna(beta): return beta
    if flip:
        return -beta
    return beta

m['BETA_harmonized'] = m.apply(lambda r: flip_beta(r['BETA'], r['flip'] == True), axis=1)

# Write harmonized scoring file for SNPs we can confidently align (match, swap, strand_match, strand_swap)
ok_classes = ['match','swap','strand_match','strand_swap']
harm = m[m['class'].isin(ok_classes)].copy()
# PLINK score format: SNP A1 BETA (SNP ID, effect allele, weight)
# We will make first allele = EA (effect allele) and BETA adjusted already
harm[['ID','EA','BETA_harmonized']].to_csv("harmonized_weights_for_scoring.tsv", sep="\t", index=False, header=False)

# Write category lists
m[m['class']=='match']['ID'].to_csv("snps_match.txt", index=False, header=False)
m[m['class']=='swap']['ID'].to_csv("snps_swap.txt", index=False, header=False)
m[m['class'].str.contains('strand')]['ID'].to_csv("snps_strandflip.txt", index=False, header=False)
m[m['class']=='ambiguous']['ID'].to_csv("snps_ambiguous.txt", index=False, header=False)
m[m['class']=='mismatch']['ID'].to_csv("snps_mismatch.txt", index=False, header=False)

# Full per-SNP report
m_report = m[['ID','CHROM_w','POS_w','EA','NEA','BETA','CHR','POS','A1','A2','class','flip','BETA_harmonized']].copy()
m_report.columns = ['ID','CHR_weights','POS_weights','EA','NEA','BETA_weights','CHR_target','POS_target','A1_target','A2_target','class','flip','BETA_harmonized']
m_report.to_csv("harmonization_report.tsv", sep="\t", index=False)

# Summary counts
summary = m['class'].value_counts()
print("\nSummary:")
print(summary.to_string())

print("\nOutputs written:")
print(" - harmonized_weights_for_scoring.tsv   (SNP EA BETA)")
print(" - harmonization_report.tsv             (detailed per-SNP info)")
print(" - snps_match.txt, snps_swap.txt, snps_strandflip.txt, snps_ambiguous.txt, snps_mismatch.txt")

