##IN R##

top10k_SNPs <- read.table('~/Downloads/pgc-mdd2025_top10k_eur_v3-49-24-11.tsv',
                 sep = '\t', header = F)

colnames(top10k_SNPs) <- c("CHROM", "POS", "ID", "EA", "NEA", "BETA", "SE", "PVAL", "FCAS","FCON", "IMPINFO", "NEFF", "NCAS", "NCON", "HETI", "HETDF", "HETPVAL")

GWAS_SS <- read.table('~/Downloads/pgc-mdd2025_no23andMe_eur_v3-49-24-11.tsv',
                 sep = '\t', header = F)
colnames(GWAS_SS) <- c("CHROM", "POS", "ID", "EA", "NEA", "BETA", "SE", "PVAL", "FCAS","FCON", "IMPINFO", "NEFF", "NCAS", "NCON", "HETI", "HETDF", "HETPVAL")

##Sort top SNPs from lowest to highest p-value##
top10k_sorted <- top10k_SNPs[order(top10k_SNPs[[8]]), ]
head(top10k_sorted)
tail(top10k_sorted)

GWAS_SS_sorted <- GWAS_SS[order(GWAS_SS[[8]]), ]
head(GWAS_SS_sorted)
tail(GWAS_SS_sorted)

##Clean and Prepare##
top10k_SNPs$CHROM <- as.character(top10k_SNPs$CHROM)
GWAS_SS$CHROM <- as.character(GWAS_SS$CHROM)

##Count SNPs per chromosome in top 10k
top_counts <- table(top10k_SNPs$CHROM)
top_props <- prop.table(top_counts)

##GWAS SumStats counts
GWAS_counts <- table(GWAS_SS$CHROM)
GWAS_props <- prop.table(GWAS_counts)

##Ensure chromosomes are matches and ordered##
common_chroms <- intersect(names(top_counts), names(GWAS_counts))

##Observed = top 10k counts##
observed <- top_counts[common_chroms]

##Expected = scale GWAS proportions to match the number of top SNPs##
expected <- GWAS_props[common_chroms] * sum(observed)

##Run Chi^2 test##
chi_results <- chisq.test(x = observed, p = GWAS_props[common_chroms])
print(chi_results)

##Create data frame to view side by side
residuals_vec <- as.numeric(chi_results$residuals[common_chroms])

## Create data frame with residuals ##
comparison <- data.frame(
  Chromosome = common_chroms,
  Observed = as.numeric(observed),
  Expected = as.numeric(expected),
  Difference = as.numeric(observed) - as.numeric(expected),
  Residual = chi_results$residuals 
)

print(chi_results$residuals)

residuals_named <- chi_results$residuals
residuals_aligned <- residuals_named[as.character(comparison$Chromosome)]

comparison$Residual <- residuals_aligned

## Create Significance column based on Residuals ##
comparison$Significance <- ifelse(
  comparison$Residual > 3, "Significantly Overrepresented",
  ifelse(comparison$Residual < -3, "Significantly Underrepresented", "Not Significant")
)

## Make Chromosome a factor ordered numerically ##
library(gtools)
comparison$Chromosome <- factor(
  as.character(comparison$Chromosome),
  levels = mixedsort(unique(as.character(comparison$Chromosome)))
)

## Plot ##
library(ggplot2)
ggplot(comparison, aes(x = Chromosome, y = Residual, fill = Significance)) +
  geom_bar(stat = "identity") +
  geom_text(aes(label = round(Residual, 2)), 
            vjust = ifelse(comparison$Residual >= 0, -0.5, 1.2), size = 3) +
  geom_hline(yintercept = 0, linetype = "dashed", color = "black") +
  scale_fill_manual(values = c(
    "Significantly Overrepresented" = "steelblue",
    "Significantly Underrepresented" = "tomato",
    "Not Significant" = "gray"
  )) +
  labs(
    title = "Standardized Residuals of SNP Counts by Chromosome in Top 10k SNPs",
    x = "Chromosome",
    y = "Standardized Residual (Chi-square test)",
    fill = "Significance"
  ) +
  theme_minimal()
