## In R ##

##### Create Weight Files #####
# Load top 10k SNPs file
top10k_SNPs <- read.table('~/Downloads/pgc-mdd2025_top10k_eur_v3-49-24-11.tsv',
                 sep = '\t', header = F)

# Assign column names
colnames(top10k_SNPs) <- c("CHROM", "POS", "ID", "EA", "NEA", "BETA", "SE", "PVAL", "FCAS","FCON", "IMPINFO", "NEFF", "NCAS", "NCON", "HETI", "HETDF", "HETPVAL")

# Extract only the columns needed for PLINK scoring
plink_weights <- top10k_SNPs[, c("ID", "EA", "BETA")]

# Save as tab-delimited text file with no quotes or row names
write.table(plink_weights, file = "~/Downloads/mdd2025_prs_weights.txt",
            sep = "\t", quote = FALSE, row.names = FALSE, col.names = TRUE)
