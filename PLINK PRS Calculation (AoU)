###########################
##### PRS Calculation #####
###########################

##### Upload Weights File to Cloud #####
# Adjust path if needed
gsutil cp ~/Downloads/top10k_prs_weights.txt ${WORKSPACE_BUCKET}/top10k_prs_weights.txt

# Verify upload
gsutil ls ${WORKSPACE_BUCKET}/top10k_prs_weights.txt

##### PLINK #####

##### Align SNPs and Alleles #####
# Align Cohort SNPs to PRS SNPs using the effect allele (A1)
plink \
  --bfile ${WORKSPACE_BUCKET}/prs_plink/filtered_cohort \
  --a1-allele ${WORKSPACE_BUCKET}/top10k_prs_weights.txt cols=1,2 \
  --make-bed \
  --out ${WORKSPACE_BUCKET}/prs/aligned_cohort

##### Drop Ambiguous Strand SNPs #####
# Ambiguous SNPs with MAF ~0.5 can't be reliably aligned
# Generate list of ambiguous SNPs
plink \
  --bfile ${WORKSPACE_BUCKET}/prs/aligned_cohort \
  --list-ambiguous-snps \
  --out ${WORKSPACE_BUCKET}/prs/ambiguous_snps

# Exclude ambiguous SNPs
plink \
  --bfile ${WORKSPACE_BUCKET}/prs/aligned_cohort \
  --exclude ${WORKSPACE_BUCKET}/prs/ambiguous_snps.snplist \
  --make-bed \
  --out ${WORKSPACE_BUCKET}/prs/cohort_noambig

##### Remove Related Individuals #####
# Use AoU provided file or PLINK --rel-cutoff, keeps 1 individual per pair of 2nd-degree relatives
plink \
  --bfile ${WORKSPACE_BUCKET}/prs/cohort_noambig \
  --rel-cutoff 0.125 \
  --make-bed \
  --out ${WORKSPACE_BUCKET}/prs/cohort_final

##### Calculate PRS #####
# 1 2 3 = columns in weights file: SNP, A1, BETA
# Outputs prs_scores.profile with PRS per individual
plink \
  --bfile ${WORKSPACE_BUCKET}/prs/cohort_final \
  --score ${WORKSPACE_BUCKET}/top10k_prs_weights.txt 1 2 3 sum \
  --out ${WORKSPACE_BUCKET}/prs/prs_scores

## HAIL ##
import hail as hl
import matplotlib.pyplot as plt
import os

hl.init()

# Define bucket path
bucket = os.getenv("WORKSPACE_BUCKET")
prs_path = f"{bucket}/prs/prs_scores.profile"

##### Inspect PRS Distribution #####
# Load PRS profile into Hail
prs_table = hl.import_table('prs_scores.profile', impute=True)

# Standardize PRS
prs_table = prs_table.annotate(prs_std = (prs_table.SCORE - hl.mean(prs_table.SCORE)) / hl.stdev(prs_table.SCORE))

# Summary of prs upload
prs_table.describe()

# Plot histogram to check for outliers or unusual distributions
prs_vals = prs_table.aggregate(hl.agg.collect(prs_table.prs_std))
plt.figure(figsize=(10,6))
plt.hist(prs_vals, bins=50, color='skyblue', edgecolor='black')
plt.xlabel('Standardized PRS')
plt.ylabel('Number of Individuals')
plt.title('PRS Distribution')
plt.tight_layout()
plt.savefig("prs_distribution_hist.png")

# Upload histogram to bucket
!gsutil cp prs_distribution_hist.png {bucket}/prs/prs_distribution_hist.png
plt.close()

# Basic statistics of PRS
mean_prs = prs_table.aggregate(hl.agg.mean(prs_table.prs_std))
sd_prs = prs_table.aggregate(hl.agg.stats(prs_table.prs_std).stdev)
print(f"PRS mean: {mean_prs}, SD: {sd_prs}")

# Save Standardized PRS table to bucket
prs_df = prs_table.to_pandas()
prs_df.to_csv("prs_scores_std.csv", index=False)
!gsutil cp prs_scores_std.csv {bucket}/prs/prs_scores_std.csv

print(f"Standardized PRS table and histogram saved to {bucket}/prs/")
