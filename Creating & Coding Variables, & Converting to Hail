# Marital Status
marital_order_ord = {
    "Never Married": 0,
    "Separated": 1,
    "Divorced": 1,
    "Widowed": 1,
    "Living With Partner": 2,
    "Married": 2
}

merged_df['marital_ord'] = merged_df['Marital Status'].map(marital_order_ord)

##### SES Combined Variable (raw, no standardization) #####
merged_df['SES_score_raw'] = (
    merged_df['education_ord'] +
    merged_df['employment_ord'] +
    merged_df['marital_ord']
)

##### Summary Stats Function #####
def summary_stats(df, var_list):
    stats = {}
    for var in var_list:
        stats[var] = {
            'Mean': df[var].mean(),
            'Median': df[var].median(),
            'Std Dev': df[var].std(),
            'Min': df[var].min(),
            'Max': df[var].max()
        }
    return pd.DataFrame(stats).T

# Variables to check
raw_vars = ['education_ord', 'employment_ord', 'marital_ord', 'SES_score_raw']

##### Plot Raw Distributions #####
fig, axes = plt.subplots(2, 2, figsize=(10, 8))
axes = axes.flatten()
titles = ['Education (Ordinal)', 'Employment (Ordinal)', 'Marital Status (Ordinal)', 'SES Score (Raw Sum)']

for ax, var, title in zip(axes, raw_vars, titles):
    merged_df[var].hist(ax=ax, bins=range(int(merged_df[var].min()), int(merged_df[var].max())+2), edgecolor='black')
    ax.set_title(title)
    ax.set_xlabel('Score')
    ax.set_ylabel('Count')

plt.tight_layout()
plt.show()

##### Print Raw Summary Stats #####
print("===== Raw Variable Summary Stats =====")
print(summary_stats(merged_df, raw_vars))

##### Standardize (z-scores) #####
scaler = StandardScaler()
merged_df[['education_z', 'employment_z', 'marital_z']] = scaler.fit_transform(
    merged_df[['education_ord', 'employment_ord', 'marital_ord']]
)

# Standardized SES = average of z-scores
merged_df['SES_score_z'] = merged_df[['education_z', 'employment_z', 'marital_z']].mean(axis=1)

##### Plot Standardized Distributions #####
fig, axes = plt.subplots(2, 2, figsize=(10, 8))
axes = axes.flatten()
std_vars = ['education_z', 'employment_z', 'marital_z', 'SES_score_z']
titles_std = ['Education (Z-score)', 'Employment (Z-score)', 'Marital (Z-score)', 'SES Score (Standardized Mean)']

for ax, var, title in zip(axes, std_vars, titles_std):
    merged_df[var].hist(ax=ax, bins=30, edgecolor='black')
    ax.set_title(title)
    ax.set_xlabel('Standardized Score')
    ax.set_ylabel('Count')

plt.tight_layout()
plt.show()

##### Print Standardized Summary Stats #####
print("===== Standardized Variable Summary Stats =====")
print(summary_stats(merged_df, std_vars))

