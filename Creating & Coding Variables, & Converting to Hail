import numpy as np
import matplotlib.pyplot as plt
import pandas as pd
from scipy.stats import skew, kurtosis
from sklearn.preprocessing import StandardScaler

##### Create Age of Onset Variable #####
# Make sure date columns are datetime
merged_df['date_of_birth'] = pd.to_datetime(merged_df['date_of_birth'])
merged_df['condition_start_datetime'] = pd.to_datetime(merged_df['condition_start_datetime'])

# Calculate age of onset in whole years
merged_df['age_of_onset'] = np.floor(
    (merged_df['condition_start_datetime'] - merged_df['date_of_birth']).dt.days / 365.25
).astype('Int64')  # allows NaN for missing values

# Drop rows with missing age_of_onset
merged_df = merged_df.dropna(subset=['age_of_onset'])

# Preview first few rows
print(merged_df[['person_id', 'date_of_birth', 'condition_start_datetime', 'age_of_onset']].head())

###### Plot histogram to view distribution #####
plt.figure(figsize=(10,6))
plt.hist(merged_df['age_of_onset'], bins=30, color='skyblue', edgecolor='black')
plt.xlabel('Age of Onset (years)')
plt.ylabel('Number of Individuals')
plt.title('Distribution of Age of Onset for MDD')
plt.show()

##### Check basic statistics and skewness #####
print("Summary Statistics for Age of Onset:")
print(merged_df['age_of_onset'].describe())

age_skew = skew(merged_df['age_of_onset'])
age_kurt = kurtosis(merged_df['age_of_onset'])
print(f"\nSkewness: {age_skew:.3f}")
print(f"Kurtosis: {age_kurt:.3f}")

##### Optional: log-transform if strongly skewed #####
merged_df['age_of_onset_log'] = np.log(merged_df['age_of_onset'] + 1)

# Optional: visualize transformed variable
plt.figure(figsize=(10,6))
merged_df['age_of_onset_log'].plot(kind='hist', bins=30, color='lightgreen', edgecolor='black', density=True)
merged_df['age_of_onset_log'].plot(kind='kde', color='red')
plt.xlabel('Log-transformed Age of Onset')
plt.ylabel('Density')
plt.title('Distribution of Log-transformed Age of Onset for MDD')
plt.show()

# Check skewness after transformation
age_log_skew = skew(merged_df['age_of_onset_log'])
print(f"Skewness of log-transformed age_of_onset: {age_log_skew:.3f}")

