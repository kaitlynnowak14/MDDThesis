##### CODING VARIABLES #####
############################

merged_df['sex_binary'] = merged_df['sex_at_birth'].map({'Male': 0, 'Female': 1})

education_order = {
    "Never Attended": 0, "One Through Four": 0, "Five Through Eight": 0, "Nine Through Eleven": 0,
    "Twelve Or GED": 1, "College One to Three": 2, "College Graduate": 3, "Advanced Degree": 4
}
merged_df['education_ord'] = merged_df['Education Level'].map(education_order)

employment_order = {
    "Unable To Work": 0, "Out Of Work One Or More": 1, "Out Of Work Less Than One": 1,
    "Homemaker": 2, "Student": 2, "Employed For Wages": 3, "Self Employed": 3, "Retired": 4
}
merged_df['employment_ord'] = merged_df['Employment Status'].map(employment_order)

marital_order_ord = {
    "Never Married": 0, "Separated": 1, "Divorced": 1, "Widowed": 1,
    "Living With Partner": 2, "Married": 2
}
merged_df['marital_ord'] = merged_df['Marital Status'].map(marital_order_ord)

merged_df['education_scaled'] = merged_df['education_ord'] / 4
merged_df['employment_scaled'] = merged_df['employment_ord'] / 4
merged_df['marital_scaled'] = merged_df['marital_ord'] / 2

merged_df['SES_score'] = (
    merged_df['education_scaled'] +
    merged_df['employment_scaled'] +
    merged_df['marital_scaled']
) / 3

def summary_stats(df, var_list):
    stats = {}
    for var in var_list:
        stats[var] = {
            'Mean': df[var].mean(),
            'Median': df[var].median(),
            'Std Dev': df[var].std(),
            'Min': df[var].min(),
            'Max': df[var].max(),
            'Skew': skew(df[var].dropna()),
            'Kurtosis': kurtosis(df[var].dropna())
        }
    return pd.DataFrame(stats).T

scaled_vars = ['education_scaled', 'employment_scaled', 'marital_scaled', 'SES_score']
titles_scaled = ['Education (Scaled 0–1)', 'Employment (Scaled 0–1)', 'Marital Status (Scaled 0–1)', 'SES Score (Composite 0–1)']

fig, axes = plt.subplots(2, 2, figsize=(12, 8))
axes = axes.flatten()
for ax, var, title in zip(axes, scaled_vars, titles_scaled):
    merged_df[var].hist(ax=ax, bins=20, edgecolor='black', color='skyblue')
    merged_df[var].plot(kind='kde', ax=ax, color='red')
    ax.set_title(title)
    ax.set_xlabel('Score')
    ax.set_ylabel('Count')
plt.tight_layout()
plt.show()

print("===== Scaled Variable Summary Stats =====")
print(summary_stats(merged_df, scaled_vars))

scaler = StandardScaler()
merged_df[['education_z', 'employment_z', 'marital_z']] = scaler.fit_transform(
