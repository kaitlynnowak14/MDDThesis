##### 1. Fix chr 23 to be chr X in QCed files
# Fix chromosome 23 → X in .bim
awk '{if($1==23) $1="X"; print $0}' PGRN_AMPS_QC.bim > PGRN_AMPS_QC_hg18_chrFix.bim

awk '{print "chr"$1, $4-1, $4, $2}' PGRN_AMPS_QC_hg18_chrFix.bim > PGRN_AMPS_QC_hg18_chrFix.bed

wget http://hgdownload.cse.ucsc.edu/goldenpath/hg18/liftOver/hg18ToHg19.over.chain.gz
 gunzip hg18ToHg19.over.chain.gz

CrossMap bed hg18ToHg19.over.chain PGRN_AMPS_QC_hg18_chrFix.bed PGRN_AMPS_QC_hg19.bed

wc -l PGRN_AMPS_QC_hg18_chrFix.bed
wc -l PGRN_AMPS_QC_hg19.bed

awk '{print $1, $4, 0, $3}' PGRN_AMPS_QC_hg19.bed > liftover_map.txt

awk 'NR==FNR{a[$2]=$5"\t"$6; next} $2 in a{print $1, $2, $3, $4, a[$2]}' PGRN_AMPS_QC.bim liftover_map.txt > PGRN_AMPS_QC_hg19.bim

awk '{print $2}' PGRN_AMPS_QC_hg19.bim > snps_to_keep.txt

plink --bfile PGRN_AMPS_QC \
      --keep PGRN_AMPS_QC.fam \
      --extract snps_to_keep.txt \
      --make-bed \
      --out PGRN_AMPS_QC_hg19_safe

##### Flip strands if needed
plink --bfile PGRN_AMPS_QC_hg19_safe \
      --flip flip.txt \
      --make-bed \
      --out PGRN_AMPS_QC_hg19_flipped

##### Remove SNPs that failed genotyping (call rate < 98%)
plink --bfile PGRN_AMPS_QC_hg19_flipped \
      --geno 0.02 \
      --make-bed \
      --out PGRN_AMPS_QC_hg19_genotyped



