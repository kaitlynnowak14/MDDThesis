# Get text file of Chr:BP SNPs that successfully scored EA
cat EA_autosomes.bim EA_chrX.bim > EA_all.bim
cat PRS_EA_autosomes.nopred PRS_EA_chrX.nopred > PRS_EA_all.nopred
cut -f2 EA_all.bim > EA_snps_all.txt
cut -f1 PRS_EA_all.nopred > skipped_EA_snps_all.txt
grep -Fvxf skipped_EA_snps_all.txt EA_snps_all.txt > scored_EA_snps_all.txt
awk 'NR==FNR{a[$1]; next} $2 in a {print $1, $2}' scored_EA_snps_all.txt EA_all.bim > chr_scored_EA_all.txt
echo -e "CHR\tSNP_ID" | cat - chr_scored_EA_all.txt > chr_scored_EA_all_with_header.txt

# Get text file of Chr:BP SNPs that successfully scored MA
# ---------- Step 1: Combine .bim files ----------
cat MA_autosomes.bim MA_chrX.bim > MA_all.bim

# ---------- Step 2: Combine .nopred files ----------
cat PRS_MA_autosomes.nopred PRS_MA_chrX.nopred > PRS_MA_all.nopred

# ---------- Step 3: Get all SNPs ----------
cut -f2 MA_all.bim > MA_snps_all.txt

# ---------- Step 4: Get scored SNPs ----------
cut -f1 PRS_MA_all.nopred > skipped_MA_snps_all.txt
grep -Fvxf skipped_MA_snps_all.txt MA_snps_all.txt > scored_MA_snps_all.txt

# ---------- Step 5: Add chromosome info ----------
awk 'NR==FNR{a[$1]; next} $2 in a {print $1, $2}' scored_MA_snps_all.txt MA_all.bim > chr_scored_MA_all.txt

# ---------- Step 6: Add header ----------
echo -e "CHR\tSNP_ID" | cat - chr_scored_MA_all.txt > chr_scored_MA_all_with_header.txt

# ---------- Step 7: Quick check ----------
head chr_scored_MA_all_with_header.txt
