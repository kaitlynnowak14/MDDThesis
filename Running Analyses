    plt.show()

####################################
##### 2-WAY INTERACTION MODELS #####
####################################
# Sex x PRS, Sex X SES, PRS x SES
import statsmodels.formula.api as smf

# Define the interaction pairs
interactions = [
    ('sex_binary', 'prs_std'),
    ('sex_binary', 'SES_score'),
    ('prs_std', 'SES_score')
]

# Outcome
outcome = 'age_of_onset'  # or 'age_of_onset_log'

# Run models with interaction terms
interaction_results = []

for var1, var2 in interactions:
    # Build formula: main effects + interaction
    formula = f"{outcome} ~ {var1} + {var2} + {var1}:{var2}"
    
    # Fit model
    model = smf.ols(formula=formula, data=df).fit()
    
    # Extract interaction term results
    interaction_term = f'{var1}:{var2}'
    coef = model.params[interaction_term]
    pval = model.pvalues[interaction_term]
    r2 = model.rsquared
    
    interaction_results.append({
        'Interaction': interaction_term,
        'Beta': coef,
        'p-value': pval,
        'R-squared': r2
    })

# Summary table
interaction_results_df = pd.DataFrame(interaction_results)
interaction_results_df

