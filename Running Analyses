##### Pull merged Hail table into Pandas #####
import pandas as pd
df = merged.to_pandas()
print(df.head())

# Quick check on structure
print(df.shape)   # rows, cols
print(df.head())  # preview first rows
print(df.columns) # check available variables

#############################
##### LINEAR REGRESSION #####
#############################
# Define predictors
predictors = ['sex_binary',        # 0=Male, 1=Female
              'prs_std',           # standardized PRS
              'SES_score',         # composite 0-1
              'education_scaled',  # scaled 0-1
              'marital_scaled',    # scaled 0-1
              'employment_scaled'] # scaled 0-1

# Run univariate regression
results = []

for pred in predictors:
    X = sm.add_constant(df[[pred]])   # predictor + intercept
    y = df['age_of_onset']            # or 'age_of_onset_log' if using log-transformed
    model = sm.OLS(y, X, missing='drop').fit()
    
    coef = model.params[pred]
    pval = model.pvalues[pred]
    r2 = model.rsquared
    results.append({'Predictor': pred, 'Beta': coef, 'p-value': pval, 'R-squared': r2})

# Convert to dataframe for summary table
univariate_results = pd.DataFrame(results)
univariate_results

# Visualize each predictor
