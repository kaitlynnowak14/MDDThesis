##### 3-WAY INTERACTION MODEL #####
###################################
# Sex x PRS x SES
import statsmodels.formula.api as smf

# Outcome
outcome = 'age_of_onset'  # or 'age_of_onset_log'

# Predictors
sex = 'sex_binary'
prs = 'prs_std'
ses = 'SES_score'

# Formula with 3-way interaction
formula_3way = f"{outcome} ~ {sex} * {prs} * {ses}"

# Fit the model
model_3way = smf.ols(formula=formula_3way, data=df).fit()

# Summary
print(model_3way.summary())

# Extract key results
interaction_term = f'{sex}:{prs}:{ses}'
coef_3way = model_3way.params[interaction_term]
pval_3way = model_3way.pvalues[interaction_term]
r2_3way = model_3way.rsquared

print(f"Three-way interaction: {interaction_term}")
print(f"Beta: {coef_3way:.4f}, p-value: {pval_3way:.4e}, R²: {r2_3way:.3f}")

##### Visualize AOO across continuous PRS and SES_score values, separately by sex #####
import matplotlib.pyplot as plt
import numpy as np
from mpl_toolkits.mplot3d import Axes3D
import statsmodels.api as sm

# Fit model with continuous predictors
X = df[[sex, prs, ses]]
X = sm.add_constant(X)
X['sex:prs'] = df[sex] * df[prs]
X['sex:ses'] = df[sex] * df[ses]
X['prs:ses'] = df[prs] * df[ses]
X['sex:prs:ses'] = df[sex] * df[prs] * df[ses]

y = df['age_of_onset']

model = sm.OLS(y, X).fit()

# Create grid for plotting
prs_vals = np.linspace(df[prs].min(), df[prs].max(), 30)
ses_vals = np.linspace(df[ses].min(), df[ses].max(), 30)
PRS, SES = np.meshgrid(prs_vals, ses_vals)

# Pick sex (0 or 1)
SEX = 0  # male
AGE_pred = (model.params['const'] + 
            model.params[sex]*SEX +
            model.params[prs]*PRS + 
            model.params[ses]*SES +
            model.params['sex:prs']*SEX*PRS +
            model.params['sex:ses']*SEX*SES +
            model.params['prs:ses']*PRS*SES +
            model.params['sex:prs:ses']*SEX*PRS*SES)

# Plot
fig = plt.figure(figsize=(10,7))
ax = fig.add_subplot(111, projection='3d')
ax.plot_surface(PRS, SES, AGE_pred, cmap='viridis', alpha=0.8)
ax.set_xlabel('PRS (std)')
ax.set_ylabel('SES score')
ax.set_zlabel('Predicted Age of Onset')
ax.set_title('3-Way Interaction Surface (Sex=Male)')
plt.show()

