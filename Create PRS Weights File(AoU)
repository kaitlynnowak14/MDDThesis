# ===============================
# Multi-Ancestry 697 SNP Liftover
# ===============================

##### 1. Install and load packages #####
if (!requireNamespace("BiocManager", quietly = TRUE))
  install.packages("BiocManager")

# Install required Bioconductor packages (force = TRUE ensures version alignment)
BiocManager::install(c("GenomicRanges", "rtracklayer", "BSgenome.Hsapiens.UCSC.hg38"), 
                     ask = FALSE, force = TRUE)

# Load required libraries
library(GenomicRanges)
library(rtracklayer)
library(BSgenome.Hsapiens.UCSC.hg38)
library(dplyr)
library(readxl)

##### 2. Load top SNPs file #####
topMA_SNPs <- read.csv('~/Downloads/Multi-Ancestry Top 697 SNPs.csv',
                          skip = 1, header = FALSE)

# Assign correct column names
colnames(topMA_SNPs) <- c("Locus.Index", "SNP.Index", "SNP", "CHR", "BP", "A1", "A2", "FRQ_A", 
                           "FRQ_U","INFO", "OR", "SE", "P", "HetISqt","HetDf", "HetPVa",
                           "Nca", "Nco", "Neff_half", "Neff", "bJ", "bJ_se", "pJ",
                           "Locus.Left", "Locus.Right")

# Keep a copy of the pre-liftover data
topMA_before <- topMA_SNPs

##### 3. Liftover GRCh37 -> GRCh38 (hg19 -> hg38) #####

# Fix sex chromosome coding
topMA_SNPs$CHR[topMA_SNPs$CHR == 23] <- "X"
topMA_SNPs$CHR[topMA_SNPs$CHR == 24] <- "Y"   # if present

# Add chr to chromosome
topMA_SNPs$CHR <- paste0("chr", topMA_SNPs$CHR)

# Create GRanges object for GRCh37
gr37 <- GRanges(
  seqnames = topMA_SNPs$CHR,
  ranges = IRanges(start = topMA_SNPs$BP, end = topMA_SNPs$BP),
  SNP = topMA_SNPs$SNP
)

# Import UCSC chain file
chain <- import.chain("~/Downloads/hg19ToHg38.over.chain")

# Perform liftover
lifted <- liftOver(gr37, chain)
lifted_flat <- unlist(lifted) #flatten results

##### 4. Add GRCh38 positions to dataframe #####

# Initialize NA columns
topMA_SNPs$CHR_hg38 <- NA
topMA_SNPs$BP_hg38 <- NA

# Map results back to the correct SNPs
matched_indices <- match(lifted_flat$SNP, topMA_SNPs$SNP)

topMA_SNPs$CHR_hg38[matched_indices] <- as.character(seqnames(lifted_flat))
topMA_SNPs$BP_hg38[matched_indices]  <- start(lifted_flat)

##### 5. Count SNPs that failed liftover #####
sum(is.na(topMA_SNPs$BP_hg38))

##### 6. Replace original CHR/BP with the GRCh38 values
topMA_SNPs$CHR <- topMA_SNPs$CHR_hg38
topMA_SNPs$BP  <- topMA_SNPs$BP_hg38

##### 7. Create final cleaned dataset (with GRCh38 positions) #####
finalMA_SNPs <- topMA_SNPs %>%
  select(
    SNP,CHR, BP, A1, A2, BETA = bJ
  )

##### 8. Create PLINK PRS weight file #####
finalMA_PLINK <- finalMA_SNPs %>%
  select(CHR, BP, A1, A2, BETA)

##### 9. Save files #####
write.csv(finalMA_SNPs,
          "~/Downloads/TopMA_SNPs_GRCh38_cleaned.csv",
          row.names = FALSE)

write.table(finalMA_PLINK,
            "~/Downloads/TopMA_SNPs_GRCh38_PRS_WEIGHTS.txt",
            row.names = FALSE,
            col.names = TRUE,
            quote = FALSE,
            sep = "\t")

# ===============================
# Euro-Ancestry 622 SNP Liftover
# ===============================
##### 1. Load top SNPs file #####
topEA_SNPs <- read.csv('~/Downloads/European Ancestry Top 556 SNPs.csv',
                       skip = 1, header = FALSE)

# Assign correct column names
colnames(topEA_SNPs) <- c("Locus.Index", "SNP.Index", "SNP", "CHR", "BP", "A1", "A2", "FRQ_A", 
                          "FRQ_U","INFO", "OR", "SE", "P","ngt", "HetISqt", "HetDf", "HetPVa",
                          "Nca", "Nco", "Neff_half", "bJ", "bJ_se", "pJ",
                          "Locus.Left", "Locus.Right")

# Keep a copy of the pre-liftover data
topEA_before <- topEA_SNPs

##### 2. Liftover GRCh37 -> GRCh38 (hg19 -> hg38) #####

# Fix sex chromosome coding
topEA_SNPs$CHR[topEA_SNPs$CHR == 23] <- "X"
topEA_SNPs$CHR[topEA_SNPs$CHR == 24] <- "Y"   # if present

# Add chr to chromosome
topEA_SNPs$CHR <- paste0("chr", topEA_SNPs$CHR)

# Create GRanges object for GRCh37
EAgr37 <- GRanges(
  seqnames = topEA_SNPs$CHR,
  ranges = IRanges(start = topEA_SNPs$BP, end = topEA_SNPs$BP),
  SNP = topEA_SNPs$SNP
)

# Import UCSC chain file
chain <- import.chain("~/Downloads/hg19ToHg38.over.chain")

# Perform liftover
EAlifted <- liftOver(EAgr37, chain)
EAlifted_flat <- unlist(EAlifted) #flatten results

##### 4. Add GRCh38 positions to dataframe #####
# Initialize NA columns
topEA_SNPs$CHR_hg38 <- NA
topEA_SNPs$BP_hg38 <- NA

# Map results back to the correct SNPs
EAmatched_indices <- match(EAlifted_flat$SNP, topEA_SNPs$SNP)

topEA_SNPs$CHR_hg38[EAmatched_indices] <- as.character(seqnames(EAlifted_flat))
topEA_SNPs$BP_hg38[EAmatched_indices]  <- start(EAlifted_flat)

##### 5. Count/Remove SNPs that failed liftover #####
sum(is.na(topEA_SNPs$BP_hg38))

# Remove 1 SNP that failed liftover
topEA_SNPs <- topEA_SNPs[topEA_SNPs$SNP != "rs3788337", ]

# Confirm removal
sum(is.na(topEA_SNPs$BP_hg38))

##### 6. Replace original CHR/BP with the GRCh38 values
topEA_SNPs$CHR <- topEA_SNPs$CHR_hg38
topEA_SNPs$BP  <- topEA_SNPs$BP_hg38

##### 7. Calculate BETAs for 4 chrX #####
# Rename bJ column to BETA
colnames(topEA_SNPs)[colnames(topEA_SNPs) == "bJ"] <- "BETA"

# Fill in missing BETA for chrX SNPs using ln(OR)
topEA_SNPs$BETA[is.na(topEA_SNPs$BETA) & topEA_SNPs$CHR == "chrX"] <- 
  log(topEA_SNPs$OR[is.na(topEA_SNPs$BETA) & topEA_SNPs$CHR == "chrX"])

##### 8. Create final cleaned dataset (with GRCh38 positions) #####
topEA_SNPs <- as.data.frame(topEA_SNPs)

finalEA_SNPs <- dplyr::select(topEA_SNPs, SNP, CHR, BP, A1, A2, BETA)

##### 9. Create PLINK PRS weight file #####
finalEA_PLINK <- dplyr::select(finalEA_SNPs, CHR, BP, A1, A2, BETA)

##### 10. Save files #####
write.csv(finalEA_SNPs,
          "~/Downloads/TopEA_SNPs_GRCh38_cleaned.csv",
          row.names = FALSE)

write.table(finalEA_PLINK,
            "~/Downloads/TopEA_SNPs_GRCh38_PRS_WEIGHTS.txt",
            row.names = FALSE,
            col.names = TRUE,
            quote = FALSE,
            sep = "\t")
