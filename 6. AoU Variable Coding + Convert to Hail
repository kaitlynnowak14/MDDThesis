import matplotlib.pyplot as plt
import pandas as pd
from scipy.stats import skew, kurtosis
from sklearn.preprocessing import StandardScaler
import hail as hl
import os

# Enable inline plots in Jupyter
%matplotlib inline

##### Helper function #####
bucket = os.getenv("WORKSPACE_BUCKET")
if bucket is None:
    raise ValueError("WORKSPACE_BUCKET environment variable not found.")

def save_to_bucket(df=None, fig=None, filename="output.csv", show_fig=True):
    local_path = filename
    if df is not None:
        df.to_csv(local_path, index=False)
        print(f"DataFrame saved locally as {filename}")
        display(df.head())  # Show first few rows in notebook
    if fig is not None:
        fig.savefig(local_path, bbox_inches='tight')
        print(f"Figure saved locally as {filename}")
        if show_fig:
            display(fig)  # Show figure inline
    # Upload to cloud bucket
    os.system(f"gsutil cp {local_path} {bucket}/{filename}")
    print(f"Uploaded {filename} to {bucket}")

##### Convert all datetime columns to strings for Hail #####
for col in merged_df.columns:
    if pd.api.types.is_datetime64_any_dtype(merged_df[col]):
        merged_df[col] = merged_df[col].astype(str)

##### Coding Variables #####
# Binary sex coding
merged_df['sex_binary'] = merged_df['sex_at_birth'].map({'Male': 0, 'Female': 1})

# Education
education_order = {
    "Never Attended": 0, "One Through Four": 0, "Five Through Eight": 0, "Nine Through Eleven": 0,
    "Twelve Or GED": 1, "College One to Three": 2, "College Graduate": 3, "Advanced Degree": 4
}
merged_df['education_ord'] = merged_df['Highest Grade'].map(education_order)

# Employment
employment_order = {
    "Unable To Work": 0, "Out Of Work One Or More": 1, "Out Of Work Less Than One": 1,
    "Homemaker": 2, "Student": 2, "Employed For Wages": 3, "Self Employed": 3, "Retired": 4
}
merged_df['employment_ord'] = merged_df['Employment Status'].map(employment_order)

# Marital Status
marital_order_ord = {
    "Never Married": 0, "Separated": 1, "Divorced": 1, "Widowed": 1,
    "Living With Partner": 2, "Married": 2
}
merged_df['marital_ord'] = merged_df['Current Marital Status'].map(marital_order_ord)

# Scaled variables
merged_df['education_scaled'] = merged_df['education_ord'] / 4
merged_df['employment_scaled'] = merged_df['employment_ord'] / 4
merged_df['marital_scaled'] = merged_df['marital_ord'] / 2

# Composite SES
merged_df['SES_score'] = (
    merged_df['education_scaled'] +
    merged_df['employment_scaled'] +
    merged_df['marital_scaled']
) / 3

# Save updated dataset
save_to_bucket(df=merged_df, filename="all_of_us_coded_variables.csv")

##### Scaled Plots #####
scaled_vars = ['education_scaled', 'employment_scaled', 'marital_scaled', 'SES_score']
titles_scaled = ['Education (Scaled 0–1)', 'Employment (Scaled 0–1)', 'Marital Status (Scaled 0–1)', 'SES Score (Composite 0–1)']

fig, axes = plt.subplots(2, 2, figsize=(12, 8))
axes = axes.flatten()
for ax, var, title in zip(axes, scaled_vars, titles_scaled):
    merged_df[var].hist(ax=ax, bins=20, edgecolor='black', color='skyblue')
    merged_df[var].plot(kind='kde', ax=ax, color='red')
    ax.set_title(title)
    ax.set_xlabel('Score')
    ax.set_ylabel('Count')
plt.tight_layout()
save_to_bucket(fig=fig, filename="scaled_variables_histograms.png", show_fig=True)

##### Standardize Z-Scores #####
scaler = StandardScaler()
merged_df[['education_z', 'employment_z', 'marital_z']] = scaler.fit_transform(
    merged_df[['education_ord', 'employment_ord', 'marital_ord']]
)

merged_df['SES_score_z'] = merged_df[['education_z', 'employment_z', 'marital_z']].mean(axis=1)

std_vars = ['education_z', 'employment_z', 'marital_z', 'SES_score_z']
titles_std = ['Education (Z-score)', 'Employment (Z-score)', 'Marital (Z-score)', 'SES Score (Z-mean)']

fig, axes = plt.subplots(2, 2, figsize=(12, 8))
axes = axes.flatten()
for ax, var, title in zip(axes, std_vars, titles_std):
    merged_df[var].hist(ax=ax, bins=30, edgecolor='black', color='lightgreen')
    merged_df[var].plot(kind='kde', ax=ax, color='red')
    ax.set_title(title)
    ax.set_xlabel('Standardized Score')
    ax.set_ylabel('Count')
plt.tight_layout()
save_to_bucket(fig=fig, filename="standardized_variables_histograms.png", show_fig=True)

# Save final dataset with all coded/scaled/z variables
save_to_bucket(df=merged_df, filename="all_of_us_final_dataset.csv")

##### Summary Statistics #####
def compute_summary_stats(df, var_list):
    stats = []
    for var in var_list:
        stats.append({
            "Variable": var,
            "Mean": df[var].mean(),
            "Median": df[var].median(),
            "StdDev": df[var].std(),
            "Min": df[var].min(),
            "Max": df[var].max(),
            "Skew": skew(df[var].dropna()),
            "Kurtosis": kurtosis(df[var].dropna())
        })
    return pd.DataFrame(stats)

# Summary stats for scaled variables
scaled_stats_df = compute_summary_stats(merged_df, scaled_vars)
save_to_bucket(df=scaled_stats_df, filename="summary_scaled_variables.csv")

# Summary stats for standardized variables
std_stats_df = compute_summary_stats(merged_df, std_vars)
save_to_bucket(df=std_stats_df, filename="summary_standardized_variables.csv")

