#############################
##### PCA + PRS Merging #####
#############################

import hail as hl
import matplotlib.pyplot as plt
import os

hl.init()

bucket = os.getenv('WORKSPACE_BUCKET')

##### Initialize & Load Genotypes
# Load cohort_final PLINK data from bucket
mt_path = f'{bucket}/prs/cohort_final.bed'  # PLINK .bed/.bim/fam prefix
mt = hl.import_plink(
    bfile=mt_path,
    reference_genome='GRCh38'
)

# Filter to autosomal, common, biallelic SNPs
mt = mt.filter_rows(hl.is_autosomal(mt.locus) & (hl.len(mt.alleles) == 2))
mt = hl.variant_qc(mt)
mt = mt.filter_rows(mt.variant_qc.AF[1] > 0.01)

# LD pruning
pruned_ht = hl.ld_prune(mt.GT, r2=0.1, bp_window_size=250_000)
mt_pruned = mt.filter_rows(hl.is_defined(pruned_ht[mt.row_key]))

##### Compute PCA #####
# Compute top 16 PCs
eigenvalues, scores, loadings = hl.hwe_normalized_pca(mt_pruned.GT, k=16)
scores = scores.rename({'s': 'IID'})

# Save PCA scores to bucket
pca_csv_path = 'pca_scores.csv'
scores.to_pandas().to_csv(pca_csv_path, index=False)
!gsutil cp {pca_csv_path} {bucket}/pca_scores.csv

##### Load & Standardize PRS #####
# Load PRS profile
prs_table = hl.import_table(f'{bucket}/prs/prs_scores.profile', impute=True)
prs_table = prs_table.rename({'#IID': 'IID'})
prs_table = prs_table.annotate(SCORE=hl.float64(prs_table.SCORE))

# Standardize PRS
mean_score = prs_table.aggregate(hl.agg.mean(prs_table.SCORE))
sd_score = prs_table.aggregate(hl.agg.stats(prs_table.SCORE).stdev)
prs_table = prs_table.annotate(prs_std=(prs_table.SCORE - mean_score)/sd_score)

# Save standardized PRS to bucket
prs_df = prs_table.to_pandas()
prs_df.to_csv('prs_std.csv', index=False)
!gsutil cp prs_std.csv {bucket}/prs_std.csv

##### Merge PRS with PCA #####
# Key by IID for merging
prs_table = prs_table.key_by('IID')
scores = scores.key_by('IID')

prs_pca_table = prs_table.join(scores, how='inner')

# Scatterplot PCs 1 & 2
pc_vals = prs_pca_table.aggregate(hl.agg.collect((prs_pca_table.PC1, prs_pca_table.PC2)))
pc1_vals = [x[0] for x in pc_vals]
pc2_vals = [x[1] for x in pc_vals]

plt.figure(figsize=(8,6))
plt.scatter(pc1_vals, pc2_vals, alpha=0.6, s=20)
plt.xlabel('PC1')
plt.ylabel('PC2')
plt.title('PCA Scatterplot of Cohort')
plt.tight_layout()
plt.savefig('pca_scatterplot.png')
!gsutil cp pca_scatterplot.png {bucket}/pca_scatterplot.png
plt.close()

##### Remove Ancestry Outliers
# PCs 1-4: strict (6 SD)
for pc in ['PC1','PC2','PC3','PC4']:
    stats = prs_pca_table.aggregate(hl.agg.stats(prs_pca_table[pc]))
    prs_pca_table = prs_pca_table.filter(
        (prs_pca_table[pc] >= stats.mean - 6*stats.stdev) &
        (prs_pca_table[pc] <= stats.mean + 6*stats.stdev)
    )

# PCs 5-16: looser (8 SD)
for pc in [f'PC{i}' for i in range(5,17)]:
    stats = prs_pca_table.aggregate(hl.agg.stats(prs_pca_table[pc]))
    prs_pca_table = prs_pca_table.filter(
        (prs_pca_table[pc] >= stats.mean - 8*stats.stdev) &
        (prs_pca_table[pc] <= stats.mean + 8*stats.stdev)
    )

##### Inspect PRS Distribution #####
prs_vals = prs_pca_table.aggregate(hl.agg.collect(prs_pca_table.prs_std))

plt.figure(figsize=(10,6))
plt.hist(prs_vals, bins=50, color='skyblue', edgecolor='black')
plt.xlabel('Standardized PRS')
plt.ylabel('Number of Individuals')
plt.title('PRS Distribution')
plt.tight_layout()
plt.savefig('prs_distribution_post_pca.png')
!gsutil cp prs_distribution_post_pca.png {bucket}/prs_distribution_post_pca.png
plt.close()

# Summary
mean_prs = prs_pca_table.aggregate(hl.agg.mean(prs_pca_table.prs_std))
sd_prs = prs_pca_table.aggregate(hl.agg.stats(prs_pca_table.prs_std).stdev)
print(f"PRS mean: {mean_prs}, SD: {sd_prs}")

##### Merge PRS + PCA with Phenotypes #####
# ht_pheno: your phenotype Hail Table from merged_df
ht_pheno = ht_pheno.key_by('person_id')
prs_pca_table = prs_pca_table.rename({'IID': 'person_id'}).key_by('person_id')

# Merge tables
merged = ht_pheno.join(prs_pca_table, how='left')

# Save merged Hail Table to bucket
merged_ht_path = f'{bucket}/merged_prs_pca_phenotypes.ht'
merged.write(merged_ht_path, overwrite=True)
print(f"Merged Hail Table saved to: {merged_ht_path}")

# Quick inspection
merged.describe()
merged.show(5)
