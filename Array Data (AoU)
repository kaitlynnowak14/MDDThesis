bucket

# Load the filtered MatrixTable
array_data_mt_path = 'gs://fc-secure-6218f59e-a8a7-40a3-96cb-ee93a398ba0b/data/array_data.mt'
array_data_mt = hl.read_matrix_table(array_data_mt_path)

# Set output files path
out_path = f'{bucket}/data/array_data_plink'

# Export function
hl.export_plink(array_data_mt, out_path, ind_id = array_data_mt.s)

