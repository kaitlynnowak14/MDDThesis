###### Setup Hail #####
import os
import hail as hl

##### Set Environment #####
# Save bucket path 
bucket = os.getenv('WORKSPACE_BUCKET')
bucket

# Save genomic data bucket location
genomic_location = os.getenv("CDR_STORAGE_PATH")
genomic_location

##### Initialize Hail #####
hl.default_reference(new_default_reference = "GRCh38")

##### Load Array Hail MatrixTable #####
mt_array_path = os.getenv("MICROARRAY_HAIL_STORAGE_PATH")
mt_array_path = "gs://fc-aou-datasets-controlled/v8/microarray/hail.mt"
mt_array = hl.read_matrix_table(mt_array_path)
mt_array.count()
mt_array.describe()

##### Filter Participants #####
mdd_array_dataset = "gs://fc-secure-6218f59e-a8a7-40a3-96cb-ee93a398ba0b/data/mdd_thesis_cohort.tsv"

mdd_array_mt = (hl.import_table(mdd_array_dataset,
                              types={'person_id':hl.tstr},
                              key='person_id')
             )

array_data_mt = mt_array.semi_join_cols(mdd_array_mt)
array_data_mt.count()

# Save to workspace bucket
array_data_mt.write('gs://fc-secure-6218f59e-a8a7-40a3-96cb-ee93a398ba0b/data/array_data.mt', overwrite=True)

# Can now use in the future
!gsutil ls gs://fc-secure-6218f59e-a8a7-40a3-96cb-ee93a398ba0b/data/

##### Conclusion #####
stop = datetime.now()
print(str(stop-start))

